# 应用显示名称。
APP_NAME="家庭药箱管理后台"

# 当前运行环境；本地开发使用 local，生产环境使用 production。
APP_ENV=local

# Laravel 应用加密密钥；首次部署后使用 php artisan key:generate 生成。
APP_KEY=

# 是否显示详细错误；生产环境必须设为 false。
APP_DEBUG=true

# 应用对外基础地址；用于生成绝对 URL。
APP_URL=http://localhost

# 应用默认语言。
APP_LOCALE=zh_CN

# 默认语言不可用时使用的回退语言。
APP_FALLBACK_LOCALE=zh_CN

# Faker 生成测试数据时使用的地区语言。
APP_FAKER_LOCALE=zh_CN

# 维护模式状态保存方式；file 适合单机开发。
APP_MAINTENANCE_DRIVER=file

# 维护模式数据库存储；仅当 APP_MAINTENANCE_DRIVER=cache 时按需启用。
# APP_MAINTENANCE_STORE=database

# PHP 内置开发服务器工作进程数；Windows 环境通常不启用。
# PHP_CLI_SERVER_WORKERS=4

# bcrypt 密码哈希计算轮数。
BCRYPT_ROUNDS=12

# Sanctum 生成 API Token 时使用的前缀，便于密钥扫描识别泄漏。
SANCTUM_TOKEN_PREFIX=carenote_

# 默认日志通道。
LOG_CHANNEL=stack

# stack 日志通道包含的子通道。
LOG_STACK=single

# PHP 弃用日志通道；null 表示使用框架默认处理。
LOG_DEPRECATIONS_CHANNEL=null

# 最低日志级别；生产环境建议使用 info 或 warning。
LOG_LEVEL=debug

# 数据库驱动；CareNote 生产目标使用 PostgreSQL。
DB_CONNECTION=pgsql

# PostgreSQL 服务地址。
DB_HOST=127.0.0.1

# PostgreSQL 服务端口。
DB_PORT=5432

# CareNote 数据库名称。
DB_DATABASE=carenote

# PostgreSQL 登录用户名。
DB_USERNAME=postgres

# PostgreSQL 登录密码；只在本机 .env 或部署平台填写。
DB_PASSWORD=

# Session 保存方式。
SESSION_DRIVER=database

# Session 有效时间，单位为分钟。
SESSION_LIFETIME=120

# 是否加密 Session 内容。
SESSION_ENCRYPT=false

# Session Cookie 生效路径。
SESSION_PATH=/

# Session Cookie 生效域名；null 表示当前域名。
SESSION_DOMAIN=null

# 广播事件连接；log 表示仅写入日志。
BROADCAST_CONNECTION=log

# 默认文件系统；本地开发保持 local，业务媒体将显式使用 r2。
FILESYSTEM_DISK=local
IMAGE_UPLOAD_DISK=r2

# 队列连接；database 表示使用数据库队列表。
QUEUE_CONNECTION=database

# 缓存存储方式。
CACHE_STORE=database

# 缓存键前缀；多应用共用缓存服务时按需启用。
# CACHE_PREFIX=

# 邮件发送驱动；log 表示仅记录邮件内容，不实际发送。
MAIL_MAILER=log

# 默认发件邮箱地址。
MAIL_FROM_ADDRESS="hello@example.com"

# 默认发件人名称。
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare R2 S3 API Access Key ID。
R2_ACCESS_KEY_ID=

# Cloudflare R2 S3 API Secret Access Key；禁止提交到 Git。
R2_SECRET_ACCESS_KEY=

# Cloudflare R2 SDK 区域；R2 固定使用 auto。
R2_REGION=auto

# Cloudflare R2 私有业务文件 bucket 名称。
R2_BUCKET=

# Cloudflare R2 S3 API 地址，格式为 https://<ACCOUNT_ID>.r2.cloudflarestorage.com。
R2_ENDPOINT=

# 公共 bucket 的自定义域名；私有 bucket 保持为空。
R2_URL=

# R2 使用 virtual-hosted-style，保持 false。
R2_USE_PATH_STYLE_ENDPOINT=false

# 前端构建时显示的应用名称。
VITE_APP_NAME="${APP_NAME}"
